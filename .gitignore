# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, but keep the documented example.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Never commit credential keys.
/config/*.key
/config/credentials/*.key

# This starter ships no credentials of its own. An encrypted file whose key is
# gitignored is unreadable to everyone who clones the repository, so shipping
# one only breaks `bin/setup` on first run. Development credentials are
# generated per-machine by bin/setup.
#
# YOUR application should commit its own .enc files - that is the Rails
# convention and how production gets its secrets. Delete these two lines once
# bin/rename-app removes this block for you.
/config/credentials.yml.enc
/config/credentials/*.yml.enc


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

# RSpec / coverage
/coverage
/spec/examples.txt

# macOS
.DS_Store
