<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Teeeemplate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <%= render "shared/impersonation_banner" %>
    <%= render "shared/masthead" %>

    <main class="container" id="main">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <%# Fixed overlays are direct children of body. Nesting them inside the %>
    <%# padded .container makes their positioning depend on page layout. %>
    <%= render "shared/flashes" %>
    <%= render "shared/modal" %>
  </body>
</html>
