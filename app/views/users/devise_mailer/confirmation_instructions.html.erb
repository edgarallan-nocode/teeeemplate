<h1 style="margin:0 0 16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:22px; font-weight:300; letter-spacing:-0.03em; color:#111111;">
  Confirm your email
</h1>

<p style="margin:0 0 16px;">Hello <%= @resource.name %>,</p>

<p style="margin:0 0 16px;">
  Confirm this address to finish setting up your account.
</p>

<%= render "shared/email_button",
      url: confirmation_url(@resource, confirmation_token: @token),
      label: "Confirm my email" %>

<p style="margin:0; font-size:13px; color:#5a5a58;">
  This link expires in <%= distance_of_time_in_words(Devise.confirm_within) %>.
  If the button does not work, paste this into your browser:<br>
  <span style="word-break:break-all;"><%= confirmation_url(@resource, confirmation_token: @token) %></span>
</p>
